# MenuMagic — Environment Variables
# Copy this file to .env.local and fill in your values

# OpenAI — required for AI menu generation
OPENAI_API_KEY=sk-...

# Supabase / PostgreSQL — required for saving menus and auth
# Get from: Supabase Dashboard > Project Settings > Database > Connection string (use the pooler/transaction-mode URL)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# NextAuth v5 — required for magic link authentication
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — required for "Continue with Google" sign-in
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Resend — required for sending magic link emails
# Get from: https://resend.com/api-keys
AUTH_RESEND_KEY=re_...

# Instacart — required for "Send to Instacart" shopping list export
# Get from: https://docs.instacart.com/developer_platform_api/api/connect
INSTACART_API_KEY=...

# Admin allowlist — comma-separated emails that bypass the free generation limit
ADMIN_EMAILS=you@example.com
